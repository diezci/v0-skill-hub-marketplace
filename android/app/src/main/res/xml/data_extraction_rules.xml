<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Las sesiones, cookies y archivos de Diime no deben restaurarse en
         otro dispositivo. El usuario debe autenticarse de nuevo. -->
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
