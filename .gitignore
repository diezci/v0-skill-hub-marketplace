# keys or are generated locally and must never be committed.
*.jks
*.keystore
*.p12
*.mobileprovision
/android/key.properties
/android/app/release/
/ios/App/diime-ios-simulator.png

# El ejemplo sí se versiona: solo lleva nombres de variables, ningún valor.
!.env.example
