# Copia este archivo a .env.local y rellena los valores.
# En producción, las mismas variables van en Vercel > Settings > Environment Variables.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave de servicio: se salta la RLS, así que NUNCA lleva el prefijo NEXT_PUBLIC_
# ni debe aparecer en el navegador. Se usa en el servidor para leer el correo de
# quien recibe un aviso (puede no tener relación previa con quien lo provoca).
# Supabase > Project Settings > API > service_role.
# Si falta, la web funciona igual pero no se manda ningún correo.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe ---
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Resend (correos transaccionales) ---
# Alta en resend.com, verificar el dominio diime.es y crear una API key.
# Si falta, la web funciona igual pero no se manda ningún correo.
RESEND_API_KEY=
# Remitente. El dominio debe estar verificado en Resend.
RESEND_FROM="Diime <avisos@diime.es>"

# URL pública, para los enlaces de los correos. Por defecto https://www.diime.es
NEXT_PUBLIC_SITE_URL=https://www.diime.es
