# Copia este archivo a .env.local y rellena los valores.
# En producción, las mismas variables van en Vercel > Settings > Environment Variables.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave de servicio: se salta la RLS, así que NUNCA lleva el prefijo NEXT_PUBLIC_
# ni debe aparecer en el navegador. Se usa en el servidor para leer el correo de
# quien recibe un aviso (puede no tener relación previa con quien lo provoca).
# Supabase > Project Settings > API > service_role.
# Si falta, la web funciona igual pero no se manda ningún correo.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe ---
# Credenciales canónicas de la cuenta real de Diime. Tienen prioridad sobre
# las variables estándar que pueda inyectar un sandbox/integración de Vercel.
DIIME_STRIPE_SECRET_KEY=
NEXT_PUBLIC_DIIME_STRIPE_PUBLISHABLE_KEY=
# Firma del endpoint real /api/stripe/webhook.
DIIME_STRIPE_WEBHOOK_SECRET=

# Fallbacks para desarrollo o sandbox.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Opcional: configuración de métodos de pago (pmc_...) creada en Stripe.
# Si se omite, Checkout usa la configuración predeterminada de la cuenta.
STRIPE_PAYMENT_METHOD_CONFIGURATION_ID=

# --- Resend (correos transaccionales) ---
# Alta en resend.com, verificar el dominio diime.es y crear una API key.
# Si falta, la web funciona igual pero no se manda ningún correo.
RESEND_API_KEY=
# Remitente. El dominio debe estar verificado en Resend.
RESEND_FROM="Diime <avisos@diime.es>"

# --- Control operativo diario ---
# Vercel Cron añade este valor al header Authorization.
CRON_SECRET=
# Destinatario de alertas. Si se omite, se usa contacto@diime.es.
OPERATIONS_ALERT_EMAIL=contacto@diime.es

# URL pública, para los enlaces de los correos. Por defecto https://www.diime.es
NEXT_PUBLIC_SITE_URL=https://www.diime.es

# --- App nativa (Capacitor) ---
# Por defecto carga producción. Se puede apuntar una compilación interna a un
# entorno de staging sin modificar capacitor.config.ts.
CAPACITOR_APP_URL=https://www.diime.es
# Logs de la capa nativa: deben permanecer desactivados en las builds de tienda.
CAPACITOR_DEBUG=false

# --- Notificaciones push nativas ---
# Android/FCM: JSON completo de la cuenta de servicio de Firebase, guardado
# únicamente como secreto del servidor (nunca NEXT_PUBLIC_).
FIREBASE_SERVICE_ACCOUNT_JSON=

# iOS/APNs: clave .p8 con Push Notifications habilitado.
APNS_KEY_ID=
APPLE_TEAM_ID=
APNS_PRIVATE_KEY=
APNS_BUNDLE_ID=es.diime.app

# --- Sign in with Apple ---
# El proveedor ya está configurado en Apple Developer y Supabase. Déjalo activo;
# usa "false" únicamente como apagado de emergencia.
NEXT_PUBLIC_APPLE_LOGIN=true
